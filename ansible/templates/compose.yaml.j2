services:
  api:
{% if deployment_mode == 'source' %}
    build:
      context: .
{% endif %}
    image: "{{ app_image }}"
    restart: unless-stopped
    ports:
      - "{{ app_port }}:8000"
    environment:
      APP_VERSION: "{{ app_version }}"
    mem_limit: 256m
    cpus: 0.5
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"
      interval: 5s
      timeout: 3s
      retries: 6
      start_period: 10s
